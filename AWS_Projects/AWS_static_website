aws amplify start-deployment \
  --app-id Math \
  --branch-name Index.html \
  --source-url <S3_URL_OF_ZIP_FILE>


--app-id: The ID of your Amplify app. You can find this in the AWS Console under the Amplify section.
--branch-name: The name of the branch where the ZIP file will be deployed.
--source-url: The S3 URL of the ZIP file to deploy. You must upload the ZIP file to an S3 bucket first.