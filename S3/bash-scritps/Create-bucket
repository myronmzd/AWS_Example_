#!/usr/bin/env bash

echo "== Create a bucket =="

# Check if a bucket name is provided
if [ -z "$1" ]; then 
    echo "❌ There needs to be a bucket name. Example usage:"
    echo "./Create-bucket.sh my-bucket-name [aws-profile]"
    exit 1
fi 

BUCKET_NAME=$1
AWS_PROFILE_NAME=${2:-my-profile}  # If no profile is provided, use "default"

echo "🛠️ Using AWS profile: $AWS_PROFILE_NAME"

# Create S3 bucket using the specified profile
aws s3api create-bucket --bucket "$BUCKET_NAME" \
  --create-bucket-configuration LocationConstraint=ap-south-1 \
  --profile "$AWS_PROFILE_NAME"

# Check if the bucket was created successfully
if [ $? -eq 0 ]; then
    echo "✅ S3 bucket '$BUCKET_NAME' created successfully using profile '$AWS_PROFILE_NAME'."
else
    echo "❌ Failed to create S3 bucket '$BUCKET_NAME'."
    exit 1
fi
